{
  "name": "apexq-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "better-auth migrate --config src/auth.ts --yes",
    "generate": "better-auth generate --config src/auth.ts --yes --output schema.sql",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.7",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
